{
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": { "vitest": ["./node_modules/vitest"] },
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["vite/client", "google.maps"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.svelte",
    "../internal/plugins/**/*.ts",
    "../internal/plugins/**/*.svelte",
    "vite.config.ts"
  ]
}
